# Copier en .env — ne jamais committer le .env réel.

# ollama (défaut, local et gratuit) | openai_compatible (OpenRouter, Runpod/vLLM, ...)
LLM_PROVIDER=ollama

# Nom du modèle Qwen. Doit correspondre à ce qui est disponible chez le fournisseur.
# Si LLM_PROVIDER=openai_compatible pointe vers OpenRouter, DOIT se terminer par
# ":free" sauf si ALLOW_PAID_MODEL=true est explicitement positionné plus bas
# (règle anti-dérapage de coût, cf. atlas_deck/llm.py::_verifier_regle_anti_derapage).
# Qwen n'a actuellement aucun modèle gratuit sur OpenRouter — repli possible :
# inclusionai/ling-3.0-flash-vl:free (tool-calling confirmé).
QWEN_MODEL=qwen2.5:7b-instruct

# >0 nécessaire pour que les tentatives de correction du nœud `plan` (schéma
# invalide) aient une chance de produire une réponse différente.
QWEN_TEMPERATURE=0.3

# --- LLM_PROVIDER=openai_compatible ---
# Ex. OpenRouter : https://openrouter.ai/api/v1 (créer une clé sur openrouter.ai/keys)
# Ex. Runpod (vLLM) : https://<pod-id>-8000.proxy.runpod.net/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=

# true pour autoriser explicitement un modèle payant sur OpenRouter (sinon
# get_llm() refuse de démarrer). Laisser à false/absent par défaut.
ALLOW_PAID_MODEL=false

# --- LLM_PROVIDER=ollama ---
OLLAMA_BASE_URL=http://localhost:11434
